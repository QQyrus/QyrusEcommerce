{
  "openapi": "3.0.3",
  "info": {
    "title": "Qyrus Ecommerce API",
    "description": "Common API contract shared by the Python (FastAPI), Java (Spring Boot) and C# (ASP.NET Core) backend implementations of the Qyrus Ecommerce sample application.",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Auth" },
    { "name": "Products" },
    { "name": "Account" },
    { "name": "Cart" },
    { "name": "Favorites" },
    { "name": "Orders" },
    { "name": "Addresses" },
    { "name": "Contact" }
  ],
  "paths": {
    "/auth/login/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email and password",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/signup/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create a new account and send a verification token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } } }
        },
        "responses": {
          "200": { "description": "Signup successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenMessageResponse" } } } },
          "400": { "description": "Email already registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/verify-email/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify an account using the OTP and token sent at signup",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyEmailRequest" } } }
        },
        "responses": {
          "200": { "description": "Email verified", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "400": { "description": "Invalid OTP or token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/forgot-password/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a password reset token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } }
        },
        "responses": {
          "200": { "description": "Reset token issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenMessageResponse" } } } },
          "404": { "description": "Email not registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/reset-password/": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset the account password using the OTP and token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" } } }
        },
        "responses": {
          "200": { "description": "Password reset", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "400": { "description": "Invalid OTP or token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-products/": {
      "get": {
        "tags": ["Products"],
        "summary": "List products by category/subcategory, paginated",
        "parameters": [
          { "name": "category", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "subcategory", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } }
        ],
        "responses": {
          "200": { "description": "Paginated product list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductListResponse" } } } }
        }
      }
    },
    "/search-products/": {
      "get": {
        "tags": ["Products"],
        "summary": "Search products by name (case-insensitive substring match)",
        "parameters": [
          { "name": "query", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Matching products", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductSearchResponse" } } } }
        }
      }
    },
    "/get-product-categories/": {
      "get": {
        "tags": ["Products"],
        "summary": "Get the static category/subcategory tree",
        "responses": {
          "200": { "description": "Category map", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoriesResponse" } } } }
        }
      }
    },
    "/get-product-details/{productId}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get full details for a single product",
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "404": { "description": "Product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-account-details/": {
      "get": {
        "tags": ["Account"],
        "summary": "Get account profile details",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Account details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetails" } } } },
          "404": { "description": "Account details not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/update-account-details/": {
      "post": {
        "tags": ["Account"],
        "summary": "Update account profile details",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAccountDetailsRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAccountDetailsResponse" } } } },
          "404": { "description": "Account not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-cart/": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get the current user's cart, enriched with product details",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Cart contents", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/add-to-cart/": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add an item to the cart",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddToCartRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated cart", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartMessageResponse" } } } },
          "404": { "description": "User or product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/remove-from-cart/": {
      "delete": {
        "tags": ["Cart"],
        "summary": "Remove an item from the cart",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemoveFromCartRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated cart", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartMessageResponse" } } } },
          "404": { "description": "User, cart or item not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/add-favorite/": {
      "post": {
        "tags": ["Favorites"],
        "summary": "Add a product to favorites",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoriteRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated favorites list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoritesMessageResponse" } } } },
          "404": { "description": "User or product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-favorites/": {
      "get": {
        "tags": ["Favorites"],
        "summary": "Get the current user's favorite product ids",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Favorites list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoritesResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/remove-favorite/": {
      "delete": {
        "tags": ["Favorites"],
        "summary": "Remove a product from favorites",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoriteRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated favorites list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavoritesMessageResponse" } } } },
          "404": { "description": "User, favorites or product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/create-address/": {
      "post": {
        "tags": ["Addresses"],
        "summary": "Add a new address for the user",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAddressRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated address list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAddressResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-addresses/": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Get the user's saved addresses",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Address list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddressesResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/delete-address/": {
      "delete": {
        "tags": ["Addresses"],
        "summary": "Delete a saved address",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteAddressRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated address list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddressesResponse" } } } },
          "404": { "description": "User or address not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/update-address/": {
      "put": {
        "tags": ["Addresses"],
        "summary": "Update a saved address",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAddressRequest" } } }
        },
        "responses": {
          "200": { "description": "Updated address list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddressesResponse" } } } },
          "404": { "description": "User or address not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/create-order/": {
      "post": {
        "tags": ["Orders"],
        "summary": "Place a new order",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } }
        },
        "responses": {
          "200": { "description": "Order created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderStatusResponse" } } } },
          "404": { "description": "User, address or product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/get-orders/": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get the user's order history",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Order list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrdersResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/cancel-order/": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel an existing order",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelOrderRequest" } } }
        },
        "responses": {
          "200": { "description": "Order cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderStatusResponse" } } } },
          "400": { "description": "Order already cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "User or order not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/record-contact/": {
      "post": {
        "tags": ["Contact"],
        "summary": "Record a contact-us message",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecordContactRequest" } } }
        },
        "responses": {
          "200": { "description": "Contact recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContactResponse" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": { "detail": { "type": "string" } }
      },
      "MessageResponse": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "TokenMessageResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "token": { "type": "string", "format": "uuid" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": ["otp", "token"],
        "properties": {
          "otp": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string", "format": "email" } }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["password", "otp", "token"],
        "properties": {
          "password": { "type": "string" },
          "otp": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "ProductColor": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "hex": { "type": "string" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number", "format": "double" },
          "image": { "type": "string" },
          "category": { "type": "string" },
          "subcategory": { "type": "string" },
          "sizes": { "type": "array", "items": { "type": "string" } },
          "colors": { "type": "array", "items": { "$ref": "#/components/schemas/ProductColor" } },
          "providers": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "rating": { "type": "number", "format": "double" },
          "comments": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ProductSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number", "format": "double" },
          "image": { "type": "string" },
          "category": { "type": "string" },
          "subcategory": { "type": "string" }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "properties": {
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/ProductSummary" } },
          "total_pages": { "type": "integer" }
        }
      },
      "ProductSearchResponse": {
        "type": "object",
        "properties": {
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/ProductSummary" } }
        }
      },
      "CategoriesResponse": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "AccountDetails": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "age": { "type": "integer", "nullable": true },
          "country": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "UpdateAccountDetailsRequest": {
        "type": "object",
        "required": ["email", "name", "phone", "age", "country"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "age": { "type": "integer" },
          "country": { "type": "string" }
        }
      },
      "UpdateAccountDetailsResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "updated_details": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "age": { "type": "integer" },
              "country": { "type": "string" }
            }
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "cart_item_id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number", "format": "double" },
          "image": { "type": "string" },
          "color": { "type": "string" },
          "provider": { "type": "string" },
          "size": { "type": "string" },
          "quantity": { "type": "integer" }
        }
      },
      "AddToCartRequest": {
        "type": "object",
        "required": ["email", "product_id", "color", "provider", "size", "quantity"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "product_id": { "type": "integer" },
          "color": { "type": "string" },
          "provider": { "type": "string" },
          "size": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "RemoveFromCartRequest": {
        "type": "object",
        "required": ["email", "cart_item_id"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "cart_item_id": { "type": "string", "format": "uuid" }
        }
      },
      "CartResponse": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "cart": { "type": "array", "items": { "$ref": "#/components/schemas/CartItem" } }
        }
      },
      "CartMessageResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "cart": { "type": "array", "items": { "$ref": "#/components/schemas/CartItem" } }
        }
      },
      "FavoriteRequest": {
        "type": "object",
        "required": ["email", "product_id"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "product_id": { "type": "integer" }
        }
      },
      "FavoritesResponse": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "favorites": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "FavoritesMessageResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "favorites": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "address_id": { "type": "string", "format": "uuid" },
          "address": { "type": "string" }
        }
      },
      "CreateAddressRequest": {
        "type": "object",
        "required": ["email", "address"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "address": { "type": "string" }
        }
      },
      "CreateAddressResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "address_id": { "type": "string", "format": "uuid" },
          "addresses": { "type": "array", "items": { "$ref": "#/components/schemas/Address" } }
        }
      },
      "AddressesResponse": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "addresses": { "type": "array", "items": { "$ref": "#/components/schemas/Address" } },
          "message": { "type": "string" }
        }
      },
      "DeleteAddressRequest": {
        "type": "object",
        "required": ["email", "addressId"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "addressId": { "type": "string", "format": "uuid" }
        }
      },
      "UpdateAddressRequest": {
        "type": "object",
        "required": ["email", "addressId", "newAddress"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "addressId": { "type": "string", "format": "uuid" },
          "newAddress": { "type": "string" }
        }
      },
